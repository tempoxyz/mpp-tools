{
  "$schema": "../../schemas/adapter-manifest.schema.json",
  "schema": 1,
  "name": "typescript",
  "language": "typescript",
  "reference": true,
  "sdk": {
    "package": "ox",
    "manifest": "package.json",
    "lockfile": "package-lock.json"
  },
  "build": [
    "npm",
    "ci",
    "--silent"
  ],
  "command": [
    "node",
    "adapter.ts"
  ],
  "cwd": ".",
  "capabilities": [
    "tx.sign",
    "tx.decode",
    "key_authorization.sign",
    "signature.recover"
  ]
}
