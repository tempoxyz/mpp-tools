{
  "$schema": "../../schemas/adapter-manifest.schema.json",
  "schema": 1,
  "name": "python",
  "language": "python",
  "sdk": {
    "package": "pytempo",
    "manifest": "pyproject.toml",
    "lockfile": "uv.lock"
  },
  "build": [
    "uv",
    "sync",
    "--frozen"
  ],
  "command": [
    "uv",
    "run",
    "--frozen",
    "--no-sync",
    "python",
    "adapter.py"
  ],
  "cwd": ".",
  "capabilities": [
    "tx.sign",
    "tx.decode",
    "key_authorization.sign",
    "signature.recover"
  ]
}
