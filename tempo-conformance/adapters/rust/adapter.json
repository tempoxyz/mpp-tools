{
  "$schema": "../../schemas/adapter-manifest.schema.json",
  "schema": 1,
  "name": "rust",
  "language": "rust",
  "sdk": {
    "package": "tempo-primitives",
    "manifest": "Cargo.toml",
    "lockfile": "Cargo.lock"
  },
  "build": [
    "cargo",
    "build",
    "--release",
    "--locked"
  ],
  "command": [
    "./target/release/adapter"
  ],
  "cwd": ".",
  "capabilities": [
    "tx.sign",
    "tx.decode",
    "key_authorization.sign",
    "signature.recover"
  ]
}
