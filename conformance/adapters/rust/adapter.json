{
  "$schema": "../../schemas/adapter-manifest.schema.json",
  "schema": 1,
  "name": "rust",
  "language": "rust",
  "command": [
    "./target/release/adapter"
  ],
  "build": [
    "cargo",
    "build",
    "--release",
    "--quiet"
  ],
  "cwd": ".",
  "profile": [
    "core",
    "tempo-charge",
    "stripe-charge"
  ],
  "capabilities": [
    "challenge.parse",
    "challenge.format",
    "credential.parse",
    "credential.format",
    "receipt.parse",
    "receipt.format",
    "base64url.encode",
    "base64url.decode",
    "challenge.id",
    "http.payment_request",
    "tempo.proof.typed_data",
    "tempo.receipt.verify",
    "tempo.proof.verify",
    "stripe.external_id_binding"
  ]
}
