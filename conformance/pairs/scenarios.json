{
  "$schema": "../schemas/pair-scenarios.schema.json",
  "scenarios": [
    {
      "name": "happy_path",
      "description": "An unpaid request gets a 402 challenge; the client pays it and gets 200 with a receipt.",
      "server": {
        "realm": "pairs.conformance",
        "routes": [
          {
            "path": "/paid",
            "offers": [
              {
                "method": "tempo",
                "intent": "charge",
                "request": {
                  "amount": "1000",
                  "currency": "USD",
                  "recipient": "merchant"
                },
                "expires": "2099-01-01T00:00:00Z"
              }
            ]
          }
        ]
      },
      "steps": [
        {
          "name": "unpaid",
          "kind": "request",
          "path": "/paid"
        },
        {
          "name": "pay",
          "kind": "pay",
          "path": "/paid"
        }
      ],
      "expectedFailures": [
        {
          "client": "*",
          "server": "go",
          "steps": [
            "unpaid"
          ],
          "fields": [
            "body",
            "contentType"
          ],
          "reason": "mpp-go answers an unpaid request with a bare 402 (WWW-Authenticate and Cache-Control only, no body); mppx adds an application/problem+json payment-required body."
        },
        {
          "client": "*",
          "server": "go",
          "steps": [
            "pay"
          ],
          "fields": [
            "receipt.timestamp"
          ],
          "reason": "mpp-go formats receipt timestamps with milliseconds (2026-01-01T00:00:00.000Z); mppx keeps the method's timestamp as given (2026-01-01T00:00:00Z)."
        }
      ]
    },
    {
      "name": "replay_rejected",
      "description": "A credential the server settled once is rejected when sent again.",
      "server": {
        "realm": "pairs.conformance",
        "routes": [
          {
            "path": "/paid",
            "offers": [
              {
                "method": "tempo",
                "intent": "charge",
                "request": {
                  "amount": "1000",
                  "currency": "USD",
                  "recipient": "merchant"
                },
                "expires": "2099-01-01T00:00:00Z"
              }
            ]
          }
        ]
      },
      "steps": [
        {
          "name": "unpaid",
          "kind": "request",
          "path": "/paid"
        },
        {
          "name": "paid",
          "kind": "request",
          "path": "/paid",
          "credential": {
            "from": "unpaid"
          }
        },
        {
          "name": "replayed",
          "kind": "request",
          "path": "/paid",
          "replay": "paid"
        }
      ],
      "expectedFailures": [
        {
          "client": "*",
          "server": "typescript",
          "steps": [
            "replayed"
          ],
          "fields": [
            "body.type"
          ],
          "reason": "mppx 0.11.0 answers a replayed credential with verification-failed; the core spec answers 402 invalid-challenge with a fresh challenge."
        },
        {
          "client": "*",
          "server": "python",
          "steps": [
            "replayed"
          ],
          "reason": "pympp answers a replayed credential with 403 verification-failed and no challenge (CredentialReplayedError); the core spec answers 402 invalid-challenge with a fresh challenge."
        },
        {
          "client": "rust",
          "server": "python",
          "steps": [
            "paid"
          ],
          "reason": "The rust adapter's challenge.parse returns opaque as a decoded object instead of its wire string, so it cannot echo a challenge that carries opaque (route meta, or pympp's per-challenge nonce)."
        },
        {
          "client": "*",
          "server": "go",
          "steps": [
            "unpaid"
          ],
          "fields": [
            "body",
            "contentType"
          ],
          "reason": "mpp-go answers an unpaid request with a bare 402 (WWW-Authenticate and Cache-Control only, no body); mppx adds an application/problem+json payment-required body."
        },
        {
          "client": "*",
          "server": "go",
          "steps": [
            "paid"
          ],
          "fields": [
            "receipt.timestamp"
          ],
          "reason": "mpp-go formats receipt timestamps with milliseconds (2026-01-01T00:00:00.000Z); mppx keeps the method's timestamp as given (2026-01-01T00:00:00Z)."
        },
        {
          "client": "*",
          "server": "go",
          "steps": [
            "replayed"
          ],
          "reason": "mpp-go answers a replayed credential with 403 verification-failed and no challenge (ErrCredentialReplayed); the core spec answers 402 invalid-challenge with a fresh challenge."
        }
      ]
    },
    {
      "name": "cross_route_replay",
      "description": "A credential for a cheap route is rejected at an expensive route.",
      "server": {
        "realm": "pairs.conformance",
        "routes": [
          {
            "path": "/cheap",
            "offers": [
              {
                "method": "tempo",
                "intent": "charge",
                "request": {
                  "amount": "1",
                  "currency": "USD",
                  "recipient": "merchant"
                },
                "expires": "2099-01-01T00:00:00Z"
              }
            ]
          },
          {
            "path": "/expensive",
            "offers": [
              {
                "method": "tempo",
                "intent": "charge",
                "request": {
                  "amount": "1000",
                  "currency": "USD",
                  "recipient": "merchant"
                },
                "expires": "2099-01-01T00:00:00Z"
              }
            ]
          }
        ]
      },
      "steps": [
        {
          "name": "cheap_challenge",
          "kind": "request",
          "path": "/cheap"
        },
        {
          "name": "expensive_with_cheap_credential",
          "kind": "request",
          "path": "/expensive",
          "credential": {
            "from": "cheap_challenge"
          }
        }
      ],
      "expectedFailures": [
        {
          "client": "*",
          "server": "python",
          "steps": [
            "expensive_with_cheap_credential"
          ],
          "reason": "pympp answers a credential it rejects before settlement (bad challenge id, other realm, other route, expired, malformed) with a fresh payment-required challenge and reports the reason only on its payment.failed event; mppx returns the specific problem type: invalid-challenge, payment-expired or malformed-credential."
        },
        {
          "client": "*",
          "server": "go",
          "steps": [
            "cheap_challenge"
          ],
          "fields": [
            "body",
            "contentType"
          ],
          "reason": "mpp-go answers an unpaid request with a bare 402 (WWW-Authenticate and Cache-Control only, no body); mppx adds an application/problem+json payment-required body."
        }
      ]
    },
