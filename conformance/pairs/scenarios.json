    {
      "name": "malformed_authorization",
      "description": "Malformed or foreign Authorization values get a 402, never a 5xx.",
      "server": {
        "realm": "pairs.conformance",
        "routes": [
          {
            "path": "/paid",
            "offers": [
              {
                "method": "tempo",
                "intent": "charge",
                "request": {
                  "amount": "1000",
                  "currency": "USD",
                  "recipient": "merchant"
                },
                "expires": "2099-01-01T00:00:00Z"
              }
            ]
          }
        ]
      },
      "steps": [
        {
          "name": "not_base64url",
          "kind": "request",
          "path": "/paid",
          "authorization": "Payment !!!"
        },
        {
          "name": "empty_object",
          "kind": "request",
          "path": "/paid",
          "authorization": "Payment e30"
        },
        {
          "name": "empty_payment",
          "kind": "request",
          "path": "/paid",
          "authorization": "Payment"
        },
        {
          "name": "other_scheme",
          "kind": "request",
          "path": "/paid",
          "authorization": "Bearer app-token"
        }
      ],
      "expectedFailures": [
