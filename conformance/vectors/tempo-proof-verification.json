{
  "version": "1.0.0",
  "spec_ref": "Tempo zero-amount proof credential",
  "description": "Server-side verification of zero-amount Tempo proof credentials ({type: 'proof', signature}), as mppx's tempo/server/Charge.ts validates them: the EIP-712 Proof (domain MPP v3, chain 4217) binds account, challengeId and realm, and must be signed by the did:pkh source account or by an access key the AccountKeychain holds for it, unrevoked and unexpired, bare or wrapped in a Keychain V1/V2 envelope naming the source. The adapter's fake node serves eth_chainId, AccountKeychain.getKey from accessKeys, and the ERC-6492 universal validator for accounts without code. Fixture keys: source 0xf39F...2266 (Anvil account 0), access key 0x7099...79C8 (Anvil account 1).",
  "commands": {
    "operation": "tempo.proof.verify"
  },
  "scenarios": [
    {
      "name": "eoa_proof_accepted",
      "sdkVersions": {
        "python": ">=0.19.0"
      },
      "description": "A proof the source account signed itself is accepted; the receipt reference is the challenge id.",
      "tags": [
        "tempo",
        "proof",
        "zero-amount",
        "happy-path"
      ],
      "input": {
        "credential": {
          "challenge": {
            "id": "zero-amount-challenge",
            "realm": "api.example.com",
            "method": "tempo",
            "intent": "charge",
            "expires": "2030-01-01T00:00:00Z",
            "request": {
              "amount": "0",
              "currency": "0x1234567890123456789012345678901234567890",
              "recipient": "0x4567890123456789012345678901234567890123",
              "methodDetails": {
                "chainId": 4217
              }
            }
          },
          "payload": {
            "type": "proof",
            "signature": "0x0fdcedc627bc81bab63f490e0e927074a25d2bb97a7c855f5a89da231977d12a45bc75f7517c11277ee17cac32e47ee5260130200439798d6bf91aff714d178c1b"
          },
          "source": "did:pkh:eip155:4217:0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266"
        }
      },
      "expected": {
        "ok": true,
        "value": {
          "status": "success",
          "reference": "zero-amount-challenge"
        }
      }
    },
