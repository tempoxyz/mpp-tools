{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tempo.xyz/mpp-tools/conformance/schemas/adapter-request.schema.json",
  "title": "MPP Conformance Adapter Request",
  "allOf": [
    { "$ref": "adapter-request-envelope.schema.json" },
    {
      "if": { "properties": { "op": { "const": "challenge.parse" } }, "required": ["op"] },
      "then": { "properties": { "input": { "$ref": "protocol.schema.json#/$defs/HeaderInput" } } }
    },
    {
      "if": { "properties": { "op": { "const": "challenge.format" } }, "required": ["op"] },
      "then": { "properties": { "input": { "$ref": "protocol.schema.json#/$defs/Challenge" } } }
    },
    {
      "if": { "properties": { "op": { "const": "credential.parse" } }, "required": ["op"] },
      "then": { "properties": { "input": { "$ref": "protocol.schema.json#/$defs/HeaderInput" } } }
    },
    {
      "if": { "properties": { "op": { "const": "credential.format" } }, "required": ["op"] },
      "then": { "properties": { "input": { "$ref": "protocol.schema.json#/$defs/Credential" } } }
    },
    {
      "if": { "properties": { "op": { "const": "receipt.parse" } }, "required": ["op"] },
      "then": { "properties": { "input": { "$ref": "protocol.schema.json#/$defs/HeaderInput" } } }
    },
    {
      "if": { "properties": { "op": { "const": "receipt.format" } }, "required": ["op"] },
      "then": { "properties": { "input": { "$ref": "protocol.schema.json#/$defs/Receipt" } } }
    },
    {
      "if": { "properties": { "op": { "const": "base64url.encode" } }, "required": ["op"] },
      "then": { "properties": { "input": { "$ref": "protocol.schema.json#/$defs/TextValue" } } }
    },
    {
      "if": { "properties": { "op": { "const": "base64url.decode" } }, "required": ["op"] },
      "then": { "properties": { "input": { "$ref": "protocol.schema.json#/$defs/TextValue" } } }
    },
    {
      "if": { "properties": { "op": { "const": "challenge.id" } }, "required": ["op"] },
      "then": { "properties": { "input": { "$ref": "protocol.schema.json#/$defs/ChallengeIdInput" } } }
    },
    {
      "if": { "properties": { "op": { "const": "stripe.external_id_binding" } }, "required": ["op"] },
      "then": { "properties": { "input": { "$ref": "protocol.schema.json#/$defs/StripeExternalIdBindingInput" } } }
    },
    {
      "if": { "properties": { "op": { "const": "tempo.proof.typed_data" } }, "required": ["op"] },
      "then": { "properties": { "input": { "$ref": "protocol.schema.json#/$defs/TempoProofInput" } } }
    },
    {
      "if": { "properties": { "op": { "const": "http.payment_request" } }, "required": ["op"] },
      "then": { "properties": { "input": { "$ref": "protocol.schema.json#/$defs/HttpPaymentRequest" } } }
    },
    {
      "if": { "properties": { "op": { "const": "server.verify" } }, "required": ["op"] },
      "then": { "properties": { "input": { "$ref": "protocol.schema.json#/$defs/ServerVerifyRequest" } } }
    },
    {
      "if": { "properties": { "op": { "const": "tempo.fee_payer.cosign" } }, "required": ["op"] },
      "then": { "properties": { "input": { "$ref": "protocol.schema.json#/$defs/TempoFeePayerCosignInput" } } }
    },
    {
      "if": { "properties": { "op": { "const": "tempo.receipt.verify" } }, "required": ["op"] },
      "then": { "properties": { "input": { "$ref": "protocol.schema.json#/$defs/TempoReceiptVerificationInput" } } }
    }
  ]
}
