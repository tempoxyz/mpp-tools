{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tempo.xyz/mpp-tools/conformance/schemas/server-verification-cases.schema.json",
  "title": "MPP Conformance Server Verification Cases",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ServerVerificationCase"
      }
    }
  },
  "$defs": {
    "ServerVerificationCase": {
      "type": "object",
      "required": [
        "name",
        "description",
        "input",
        "expected"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "protocol.schema.json#/$defs/ServerVerifyRequest"
        },
        "expected": {
          "$ref": "protocol.schema.json#/$defs/ServerVerifyResult"
        }
      }
    }
  }
}
