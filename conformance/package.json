{
  "name": "@tempo/mpp-conformance",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test:golden": "tsx golden/adapter.ts",
    "test:all": "uv run --locked python scripts/vector_runner.py",
    "flow": "uv run --locked python scripts/flow_runner.py",
    "test:go": "uv run --locked python scripts/vector_runner.py --adapter go",
    "test:ruby": "uv run --locked python scripts/vector_runner.py --adapter ruby",
    "build:go": "make install-go",
    "build:rust": "cd adapters/rust && cargo build --locked --release",
    "build:python": "make install-python",
    "build:ruby": "make install-ruby",
    "build:all": "make install"
  },
  "dependencies": {
    "mppx": "0.8.17"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
